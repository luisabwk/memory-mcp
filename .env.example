# memory-mcp — variáveis de ambiente (defina os valores reais no Coolify, nunca commite segredos)

# --- Supabase (armazenamento de memórias + tabelas OAuth) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=               # service role key (bypassa RLS)

# --- Embeddings (endpoint compatível com a API da OpenAI; OpenRouter por padrão) ---
OPENROUTER_API_KEY=                       # obrigatório: key do endpoint de embeddings
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=text-embedding-3-small    # opcional (default text-embedding-3-small)
EMBEDDING_DIMENSIONS=1536                 # opcional (default 1536)

# --- Servidor ---
BASE_URL=https://memory.bloko.dev        # usado nos redirects e na metadata OAuth
PORT=3000                                 # porta pública (roteada pelo Traefik)
INTERNAL_PORT=8767                        # porta interna (só rede Docker; service token)

# --- Broker Google (gate de identidade do /authorize) ---
GOOGLE_CLIENT_ID=                         # OAuth Client (Web) do Google Cloud
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=voce@gmail.com             # lista separada por vírgula; só quem está aqui entra
# Redirect autorizado no Google Cloud: ${BASE_URL}/auth/google/callback

# --- Service token (clientes headless via porta interna) ---
MEMORY_SERVICE_TOKEN=                     # gere com: openssl rand -hex 32
