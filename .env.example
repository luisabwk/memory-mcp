# memory-mcp — variáveis de ambiente (defina os valores reais no Coolify, nunca commite segredos)

# --- MongoDB (armazenamento de memórias + estado OAuth) ---
# Instância dedicada ao memory-mcp — NÃO reutilizar o Mongo do workflow-credito
# (dados de produção de crédito, PII de cliente) nem qualquer outro Mongo já em uso.
# Requer MongoDB Server 8.3.4+ rodando como replica set (mesmo single-node) com
# mongot (self-managed Search/Vector Search) — ver scripts/setup-mongo-indexes.ts.
MONGODB_URI=mongodb://user:pass@host:27017/?replicaSet=rs0
MONGODB_DB=memory_mcp

# --- Servidor ---
BASE_URL=https://memory.bloko.dev        # usado nos redirects e na metadata OAuth
PORT=3000                                 # porta pública (roteada pelo Traefik)
INTERNAL_PORT=8767                        # porta interna (só rede Docker; service token)

# --- Broker Google (gate de identidade do /authorize) ---
GOOGLE_CLIENT_ID=                         # OAuth Client (Web) do Google Cloud
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=luisa.barwinski@gmail.com,guilhermeconter@gmail.com   # lista separada por vírgula; só quem está aqui entra
# Redirect autorizado no Google Cloud: ${BASE_URL}/auth/google/callback

# --- Service token (clientes headless via porta interna) ---
MEMORY_SERVICE_TOKEN=                     # gere com: openssl rand -hex 32
# Identidade para a qual o service token mapeia (confirmado: Lu, por padrão — sem
# pseudo-usuário separado por enquanto). Obrigatório sempre que MEMORY_SERVICE_TOKEN
# estiver setado; precisa estar em ALLOWED_EMAILS.
SERVICE_TOKEN_USER_EMAIL=luisa.barwinski@gmail.com

# --- Stdio (uso local/headless sem camada de auth nenhuma) ---
# Obrigatório só quando rodando via `npm start` (stdio, index.ts). Precisa estar em
# ALLOWED_EMAILS. Não usado pelo transporte HTTP (index-http.ts).
MEMORY_STDIO_USER_EMAIL=luisa.barwinski@gmail.com

# --- Embeddings (via OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://memory.bloko.dev
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Webhook do graphiti-bridge (substitui o antigo trigger Postgres) ---
# Deixe vazio para desativar a notificação (ex.: dev local).
GRAPHITI_BRIDGE_WEBHOOK_URL=https://graphiti-bridge.bloko.dev/webhook/memories
GRAPHITI_BRIDGE_WEBHOOK_SECRET=           # ROTACIONAR: não reusar o segredo antigo (estava hardcoded na function SQL)

# --- Migração única (scripts/migrate-supabase-to-mongo.ts) ---
# Só necessário para rodar a migração; remover depois de decomissionar o Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
